{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Camel Mail",
  "mainBinaryName": "remail",
  "version": "0.4.9",
  "identifier": "app.remail.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Camel Mail",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "url": "index.html",
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' about: blob:; object-src 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Fast, private desktop email",
    "longDescription": "Camel Mail is a desktop email client for any IMAP/SMTP account with a unified inbox, snooze, send later, undo send and one-click unsubscribe. All data stays on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "remail.desktop",
        "conflicts": ["remail"],
        "replaces": ["remail"]
      }
    }
  }
}
